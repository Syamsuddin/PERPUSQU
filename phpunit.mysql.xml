<?xml version="1.0" encoding="UTF-8"?>
<!--
    Konfigurasi kembar phpunit.xml, dijalankan di atas MySQL/MariaDB.
    Membuktikan bahwa skema dan kueri yang khas MySQL — indeks FULLTEXT,
    generated column pinjaman aktif, MONTH(), HAVING tanpa GROUP BY —
    berperilaku sama seperti pada SQLite yang dipakai suite harian.

    Siapkan sekali:  CREATE DATABASE perpusqu_test;
    Jalankan:        composer test:mysql
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         failOnWarning="true"
         failOnRisky="true"
>
    <testsuites>
        <!-- Aturan bisnis murni: tanpa database, tanpa HTTP. Milidetik. -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Service + endpoint di atas database sungguhan (SQLite in-memory). -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Modules/*/routes</directory>
        </exclude>
    </source>
    <coverage/>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Driver produksi. Host/user/password diambil dari .env; hanya nama
             basis data yang dipaksa agar data pengembangan tidak tersentuh. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="perpusqu_test"/>
        <env name="DB_URL" value=""/>
        <env name="DB_FOREIGN_KEYS" value="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="FILESYSTEM_DISK" value="local"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
